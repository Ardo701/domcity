/**
 * Compiles the DOMCity bookmarklet (src/bookmarklet/main.ts and the capture) into a single line,
 * stored in src/bookmarklet/generated.ts.
 *
 * npm run bookmarklet (also run before every build). A test checks that the file is up to date.
 */

import { writeFile } from "node:fs/promises";
import { fileURLToPath } from "node:url";
import { build } from "esbuild";

const root = new URL("../", import.meta.url);
const path = (relative: string) => fileURLToPath(new URL(relative, root));

export async function buildBookmarklet(): Promise<string> {
  const result = await build({
    entryPoints: [path("src/bookmarklet/main.ts")],
    tsconfig: path("tsconfig.json"),
    bundle: true,
    write: false,
    minify: true,
    format: "iife",
    platform: "browser",
    target: "es2020",
    legalComments: "none",
    logLevel: "silent",
  });
  return result.outputFiles[0].text.trim();
}

export function generatedModule(code: string): string {
  return [
    "// Generated by scripts/build-bookmarklet.mts (npm run bookmarklet): do not edit by hand.",
    "",
    "/** Minified bookmarklet code. The DOMCity address is written into it at install time (see href.ts). */",
    `export const BOOKMARKLET_CODE =\n  ${JSON.stringify(code)};`,
    "",
  ].join("\n");
}

if (process.argv[1] === fileURLToPath(import.meta.url)) {
  const code = await buildBookmarklet();
  await writeFile(path("src/bookmarklet/generated.ts"), generatedModule(code));
  console.log(`Bookmarklet compiled: ${code.length} characters.`);
}
