# DOMCity: environment variables
# Copy to .env.local for development, or enter them in Vercel (Settings → Environment Variables).
# Without them, in development, sharing runs in local mode (database and files in .data/).

# Public address of the site (share links, social previews)
SITE_URL=https://domcity.app

# Salt for IP fingerprints (upload limit, reports): a long random string
DOMCITY_SECRET=

# Supabase (Project Settings → API Keys)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key: server only, never in the browser
SUPABASE_SECRET_KEY=sb_secret_...

# Cloudflare R2 (R2 → Manage API tokens: "Object Read & Write" permission on the bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=domcity-villes
# Public domain of the bucket (no trailing /)
FILES_PUBLIC_URL=https://files.domcity.app

# Optional: purge the Cloudflare cache when a city is deleted ("Cache Purge" token on the zone)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
