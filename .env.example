# DOMCity : variables d'environnement
# Copier en .env.local pour le développement, ou les saisir dans Vercel (Settings → Environment Variables).
# Sans elles, en développement, le partage tourne en mode local (base et fichiers dans .data/).

# Adresse publique du site (liens de partage, aperçus sur les réseaux)
SITE_URL=https://domcity.app

# Sel des empreintes d'IP (limite d'envois, signalements) : une longue chaîne aléatoire
DOMCITY_SECRET=

# Supabase (Project Settings → API Keys)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Clé secrète : serveur uniquement, jamais dans le navigateur
SUPABASE_SECRET_KEY=sb_secret_...

# Cloudflare R2 (R2 → Manage API tokens : droits « Object Read & Write » sur le bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=domcity-villes
# Domaine public du bucket (sans / final)
FILES_PUBLIC_URL=https://files.domcity.app

# Facultatif : purge du cache Cloudflare quand une ville est supprimée (jeton « Cache Purge » sur la zone)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
